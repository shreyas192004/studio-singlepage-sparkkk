# ─── HTML entry point ────────────────────────────────────────────────────────
# Never cache index.html so users always get the latest deploy immediately.
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ─── Hashed JS / CSS / font assets ───────────────────────────────────────────
# Vite adds a content-hash to every asset filename, so it's safe to cache
# these forever. Browsers will automatically bust the cache when filenames
# change on the next deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ─── Public images (no hash, kept short) ─────────────────────────────────────
# Products page images etc. – 1 week is enough.
*.png
  Cache-Control: public, max-age=604800
*.jpg
  Cache-Control: public, max-age=604800
*.jpeg
  Cache-Control: public, max-age=604800
*.webp
  Cache-Control: public, max-age=604800
*.svg
  Cache-Control: public, max-age=604800
